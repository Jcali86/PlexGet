# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# Two different readers use this file, which is worth knowing before wondering
# why a value did not take. docker compose reads it on its own, for the
# optional Posteria container in docker-compose.yml. The app does not: it
# reads the environment of whatever shell started it, so a value here reaches
# it only once it has been exported, or once the service manager running it
# has been told to load this file.

# The model key, named by ai.api_key_env in config.yaml. It lives here rather
# than in config.yaml so the key never sits in a file that gets opened and
# edited and pasted into a chat window.
#
# Set it. The request page is built around the model, and this is the one line
# that turns it on. Left blank, free-form requests drop to keyword matching and
# the page stops offering an assistant it cannot reach - a working app, but a
# duller one than the one you installed.
ANTHROPIC_API_KEY=

# ---- Only needed for docker compose. ----

# The Plex token again. The Posteria container talks to Plex itself and cannot
# read config.yaml, so it has to be told separately.
PLEX_TOKEN=

# Where Posteria should look for Plex. The default reaches a server running on
# the same machine as Docker; change it only if Plex is somewhere else.
PLEX_SERVER_URL=http://host.docker.internal:32400

# The login Posteria's own web interface asks for. It creates the account from
# these on first start, so choose them before the first run rather than after.
POSTERIA_USER=admin
POSTERIA_PASSWORD=

# Which host port the poster manager answers on.
POSTERIA_PORT=1818

# Who owns the poster files the container writes. Set these to your own user
# and group, or the files come back owned by somebody who does not exist on
# this machine. `id -u` and `id -g` will tell you.
PUID=1000
PGID=1000

# Timestamps inside the container.
TZ=Etc/UTC
